# Google Gemini (chat model)
GOOGLE_API_KEY=your_google_api_key

# Hugging Face token (optional): authenticates the one-time download of the
# local embedding model BAAI/bge-small-en-v1.5. Embeddings then run offline.
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token

# Alpha Vantage (stock prices) - free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=financial-analyst-agent
